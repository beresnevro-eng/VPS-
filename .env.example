# Скопируйте в .env и заполните. Файл .env в git не коммитится.
# cp .env.example .env

BOT_TOKEN=your_token_here
BOT_USERNAME=YourBotUsername

PARTNER_A_ID=0
PARTNER_B_ID=0
PARTNER_A_NAME=PartnerA
PARTNER_B_NAME=PartnerB

# AI
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL_FALLBACKS=openai/gpt-oss-120b,qwen/qwen3.6-27b

# Runtime
TIMEZONE=Europe/Moscow
QUIZ_HOUR=10
QUIZ_MINUTE=0
API_HOST=0.0.0.0
API_PORT=8787
MINI_APP_URL=https://app.wspr.online/
# COUPLE_QUIZ_DB=/root/couple-quiz-bot/data/couple_quiz.db
# API_CORS_ORIGINS=https://beresnevro-eng.github.io,https://app.wspr.online
