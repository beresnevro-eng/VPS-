# Fornex VPS — защита SSH от брутфорса
# Копируется в /etc/fail2ban/jail.d/fornex-sshd.local

[DEFAULT]
# Локальный хост и доверенные IP (добавьте свой: ignoreip = 127.0.0.1/8 YOUR.IP.HERE)
ignoreip = 127.0.0.1/8 ::1

[sshd]
enabled = true
port = ssh
backend = systemd
maxretry = 5
findtime = 10m
bantime = 1h
