# Dante SOCKS — логи отключены (сканеры иначе раздувают syslog/journal)
# Оригинал бэкапится на сервере как /etc/danted.conf.bak.*
# Порт и auth не меняем: 0.0.0.0:1080, socksmethod username
# Вернуть логи: logoutput: syslog и log: error в правилах

logoutput: /dev/null

internal: 0.0.0.0 port = 1080
external: eth0

clientmethod: none
socksmethod: username

user.notprivileged: nobody

client pass {
  from: 0.0.0.0/0 to: 0.0.0.0/0
}

socks pass {
  from: 0.0.0.0/0 to: 0.0.0.0/0
  protocol: tcp udp
}
